DATABASE_URL="postgresql://USER@localhost:5432/budgetapp_dev?schema=public"
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Gmail import (optional — only needed to use the "Connect Gmail" feature on
# Profile). See README.md's "Gmail import setup" section for how to get
# these from Google Cloud Console.
GOOGLE_CLIENT_ID="your-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-oauth-client-secret"
# Encrypts the stored Gmail refresh token at rest — must decode to exactly
# 32 bytes, so generate it the same way as AUTH_SECRET.
GMAIL_TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
# Signs the Gmail OAuth flow's CSRF state param -- its own key, separate
# from AUTH_SECRET (which signs session cookies), so the two purposes
# don't share one secret. Falls back to AUTH_SECRET if unset, so this is
# optional but recommended; generate the same way as AUTH_SECRET.
GMAIL_OAUTH_STATE_SECRET="generate-with-openssl-rand-base64-32"

# Rate limiting (login, signup, change-password, Gmail OAuth) — backed by
# a free Upstash Redis database (upstash.com) so limits are enforced
# across every serverless instance Vercel runs, not just whichever one
# happens to handle a given request. Get both from the database's own
# "REST API" section in the Upstash dashboard.
UPSTASH_REDIS_REST_URL="https://your-database-name.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
