// Prisma schema for BudgetApp
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  hashedPassword        String
  name                  String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  incomeSources     IncomeSource[]
  expenseCategories ExpenseCategory[]
  budgetCycles      BudgetCycle[]
  gmailConnection   GmailConnection?
}

model IncomeSource {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  // What actually lands in the account each quincena — entered directly by
  // the user, no gross/deduction calculation involved.
  netQuincenaAmount Decimal  @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cycleEntries CycleIncomeEntry[]

  @@index([userId])
}

// Kept separate from User (rather than columns on it) so the encrypted
// credential isn't loaded on every ordinary user query throughout the app —
// only the Gmail sync path ever touches this table.
model GmailConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedRefreshToken String
  googleEmail           String
  lastSyncedAt          DateTime?
  lastSyncError         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model BudgetCycle {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  periodStart DateTime
  periodEnd   DateTime?
  status      CycleStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Explicit "step submitted" markers — needed because the expenses and
  // savings steps allow zero rows, so row presence can't signal completion.
  expensesConfirmedAt DateTime?
  savingsConfirmedAt  DateTime?

  incomeEntries CycleIncomeEntry[]
  budgetGoals   CycleBudgetGoal[]
  transactions  CycleTransaction[]

  @@index([userId, periodStart])
}

model CycleIncomeEntry {
  id             String        @id @default(cuid())
  cycleId        String
  cycle          BudgetCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  incomeSourceId String?
  incomeSource   IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  netAmount      Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  @@index([cycleId])
  @@index([incomeSourceId])
}

enum CategoryType {
  EXPENSE
  SAVINGS
}

enum RecurringFrequency {
  BIWEEKLY
  MONTHLY
}

model ExpenseCategory {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType @default(EXPENSE)
  icon      String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  // Whether closeCycleAndStartNext auto-carries this category's most recent
  // CycleBudgetGoal.targetAmount into the next cycle. Defaults true so
  // existing budget targets keep carrying forward exactly as before this
  // flag existed; toggled off per category for one-off targets.
  recurring Boolean @default(true)

  // Set only for SAVINGS-type categories the user has turned into a Goal —
  // the overall target total, distinct from CycleBudgetGoal.targetAmount
  // (that's the recurring per-cycle contribution). Non-null == "is a goal".
  lifetimeTargetAmount Decimal? @db.Decimal(12, 2)

  // Only meaningful when recurring == true. BIWEEKLY carries the target into
  // every new cycle (once per quincena, by definition). MONTHLY carries it
  // into exactly one quincena per month, chosen by dueDay: on/before the
  // 15th -> the first quincena of the month, after the 15th -> the second.
  // Defaults to BIWEEKLY so every category that existed before this field
  // was added keeps its old "carries into every cycle" behavior unchanged.
  frequency RecurringFrequency @default(BIWEEKLY)
  dueDay    Int?

  budgetGoals  CycleBudgetGoal[]
  transactions CycleTransaction[]

  // Was (userId, name) alone — a Budget (EXPENSE) category and a Goal
  // (SAVINGS) category with the same name used to collide silently (the
  // second upsert would just match/mutate the first, wrong-typed row).
  // type is now part of the identity, so "Travel" the expense and "Travel"
  // the goal are distinct rows.
  @@unique([userId, name, type])
}

enum TransactionType {
  EXPENSE
  INCOME
  SAVINGS
}

model CycleTransaction {
  id                String           @id @default(cuid())
  cycleId           String
  cycle             BudgetCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  type              TransactionType
  name              String
  amount            Decimal          @db.Decimal(12, 2)
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  occurredAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())

  // Set only for transactions auto-imported from Gmail (the message's own
  // id) — the hard dedupe backstop against re-importing the same email
  // twice. Null for every hand-entered transaction; Postgres treats
  // multiple NULLs as distinct under a unique index, so this never
  // collides with manual entries.
  sourceMessageId String? @unique

  @@index([cycleId])
  @@index([expenseCategoryId])
}

model CycleBudgetGoal {
  id                String          @id @default(cuid())
  cycleId           String
  cycle             BudgetCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  targetAmount      Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())

  @@unique([cycleId, expenseCategoryId])
  @@index([cycleId])
}

