// Prisma schema for BudgetApp
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  hashedPassword        String
  name                  String?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  incomeSources     IncomeSource[]
  expenseCategories ExpenseCategory[]
  financialAccounts FinancialAccount[]
  budgetCycles      BudgetCycle[]
}

model IncomeSource {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  // Salaries are quoted/contracted monthly in Panama even though pay is
  // quincenal (twice a month) -- this is the monthly figure; per-cycle
  // (quincena) amounts are always derived from it, never stored directly.
  grossMonthlyAmount Decimal  @db.Decimal(12, 2)
  isPanamaPayroll    Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cycleEntries CycleIncomeEntry[]

  @@index([userId])
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model BudgetCycle {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  periodStart DateTime
  periodEnd   DateTime?
  status      CycleStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Explicit "step submitted" markers — needed because the expenses and
  // savings steps allow zero rows, so row presence can't signal completion.
  expensesConfirmedAt DateTime?
  savingsConfirmedAt  DateTime?

  incomeEntries   CycleIncomeEntry[]
  budgetGoals     CycleBudgetGoal[]
  accountBalances CycleAccountBalance[]
  transactions    CycleTransaction[]

  @@index([userId, periodStart])
}

model CycleIncomeEntry {
  id                       String        @id @default(cuid())
  cycleId                  String
  cycle                    BudgetCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  incomeSourceId           String?
  incomeSource             IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  grossAmount              Decimal       @db.Decimal(12, 2)
  cssDeduction             Decimal       @db.Decimal(12, 2)
  seguroEducativoDeduction Decimal       @db.Decimal(12, 2)
  isrDeduction             Decimal       @db.Decimal(12, 2)
  decimoGrossAmount        Decimal?      @db.Decimal(12, 2)
  decimoCssDeduction       Decimal?      @db.Decimal(12, 2)
  decimoIsEstimated        Boolean       @default(false)
  netAmount                Decimal       @db.Decimal(12, 2)
  createdAt                DateTime      @default(now())

  @@index([cycleId])
  @@index([incomeSourceId])
}

enum CategoryType {
  EXPENSE
  SAVINGS
}

model ExpenseCategory {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType @default(EXPENSE)
  icon      String?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())

  // Whether closeCycleAndStartNext auto-carries this category's most recent
  // CycleBudgetGoal.targetAmount into the next cycle. Defaults true so
  // existing budget targets keep carrying forward exactly as before this
  // flag existed; toggled off per category for one-off targets.
  recurring Boolean @default(true)

  // Set only for SAVINGS-type categories the user has turned into a Goal —
  // the overall target total, distinct from CycleBudgetGoal.targetAmount
  // (that's the recurring per-cycle contribution). Non-null == "is a goal".
  lifetimeTargetAmount Decimal? @db.Decimal(12, 2)

  budgetGoals  CycleBudgetGoal[]
  transactions CycleTransaction[]

  // Was (userId, name) alone — a Budget (EXPENSE) category and a Goal
  // (SAVINGS) category with the same name used to collide silently (the
  // second upsert would just match/mutate the first, wrong-typed row).
  // type is now part of the identity, so "Travel" the expense and "Travel"
  // the goal are distinct rows.
  @@unique([userId, name, type])
}

enum TransactionType {
  EXPENSE
  INCOME
  SAVINGS
}

model CycleTransaction {
  id                String           @id @default(cuid())
  cycleId           String
  cycle             BudgetCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  type              TransactionType
  name              String
  amount            Decimal          @db.Decimal(12, 2)
  expenseCategoryId String?
  expenseCategory   ExpenseCategory? @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  occurredAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())

  @@index([cycleId])
  @@index([expenseCategoryId])
}

model CycleBudgetGoal {
  id                String          @id @default(cuid())
  cycleId           String
  cycle             BudgetCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  targetAmount      Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())

  @@unique([cycleId, expenseCategoryId])
  @@index([cycleId])
}

enum FinancialAccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  LOAN
  OTHER_DEBT
}

enum BalanceSnapshotType {
  OPENING
  CLOSING
}

model FinancialAccount {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      FinancialAccountType
  createdAt DateTime             @default(now())

  balances CycleAccountBalance[]

  @@index([userId])
}

model CycleAccountBalance {
  id                 String              @id @default(cuid())
  cycleId            String
  cycle              BudgetCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  financialAccountId String
  financialAccount   FinancialAccount    @relation(fields: [financialAccountId], references: [id], onDelete: Cascade)
  type               BalanceSnapshotType @default(OPENING)
  amount             Decimal             @db.Decimal(12, 2)
  recordedAt         DateTime            @default(now())

  @@unique([cycleId, financialAccountId, type])
  @@index([cycleId])
}
