// Prisma schema for BudgetApp
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  hashedPassword         String
  name                   String?
  onboardingCompletedAt  DateTime?
  // Bumped on password change (and by "Log out everywhere") -- the JWT
  // session callback compares this against the value baked into the
  // token at sign-in, so every other still-signed-in session stops
  // passing the moment either happens, on its very next request.
  sessionVersion         Int       @default(0)
  // Source of truth for the app's theme (Profile's own Theme row) --
  // mirrored into a cookie on every change so the root layout can render
  // the right [data-theme] attribute server-side without a DB round trip
  // on every request. SYSTEM defers to prefers-color-scheme, resolved
  // client-side (see app/_components/ThemeScript.tsx).
  theme                  ThemePreference @default(SYSTEM)
  // Defaults EN at the column level so this migration doesn't change any
  // EXISTING account's language -- new signups get ES explicitly in
  // signupAction instead (the app is built for Panama, but a brand-new
  // column shouldn't silently flip everyone who signed up before this
  // feature existed). Mirrored into a cookie the same way theme is; see
  // lib/i18n/locale.ts.
  locale                 Locale    @default(EN)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  incomeSources     IncomeSource[]
  expenseCategories ExpenseCategory[]
  budgetCycles      BudgetCycle[]
  gmailConnection   GmailConnection?
  recurringExpenses RecurringExpense[]
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum Locale {
  EN
  ES
}

model IncomeSource {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // What actually lands in the account each quincena — entered directly by
  // the user, no gross/deduction calculation involved.
  netQuincenaAmount Decimal  @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  cycleEntries CycleIncomeEntry[]
  // Also enforced by a partial unique index NOT representable here: at
  // most one row per userId with isActive = true. See
  // prisma/migrations/20260815035814_race_condition_partial_unique_indexes.

  @@index([userId])
}

// Kept separate from User (rather than columns on it) so the encrypted
// credential isn't loaded on every ordinary user query throughout the app —
// only the Gmail sync path ever touches this table.
model GmailConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedRefreshToken String
  googleEmail           String
  lastSyncedAt          DateTime?
  lastSyncError         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model BudgetCycle {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  periodStart DateTime
  periodEnd   DateTime?
  status      CycleStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Explicit "step submitted" markers — needed because the expenses and
  // savings steps allow zero rows, so row presence can't signal completion.
  expensesConfirmedAt DateTime?
  savingsConfirmedAt  DateTime?

  incomeEntries         CycleIncomeEntry[]
  budgetGoals           CycleBudgetGoal[]
  transactions          CycleTransaction[]
  recurringExpenseGoals CycleRecurringExpense[]
  // Also enforced by a partial unique index NOT representable here: at
  // most one row per userId with status IN (DRAFT, ACTIVE). See
  // prisma/migrations/20260815035814_race_condition_partial_unique_indexes.

  @@index([userId, periodStart])
}

model CycleIncomeEntry {
  id             String        @id @default(cuid())
  cycleId        String
  cycle          BudgetCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  incomeSourceId String?
  incomeSource   IncomeSource? @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  netAmount      Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())

  // Lets a shared upsert helper safely be the single way every callsite
  // creates-or-updates a cycle's income entry, instead of each one doing
  // its own separate find-then-branch (a narrow window for two near-
  // simultaneous calls to both see "missing" and both create).
  @@unique([cycleId, incomeSourceId])
  @@index([cycleId])
  @@index([incomeSourceId])
}

enum CategoryType {
  EXPENSE
  INCOME
  SAVINGS
}

enum RecurringFrequency {
  BIWEEKLY
  MONTHLY
}

model ExpenseCategory {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType @default(EXPENSE)
  icon      String?
  createdAt DateTime     @default(now())

  // Whether closeCycleAndStartNext auto-carries this category's most recent
  // CycleBudgetGoal.targetAmount into the next cycle. Defaults true so
  // existing budget targets keep carrying forward exactly as before this
  // flag existed; toggled off per category for one-off targets.
  recurring Boolean @default(true)

  // Set only for SAVINGS-type categories the user has turned into a Goal —
  // the overall target total, distinct from CycleBudgetGoal.targetAmount
  // (that's the recurring per-cycle contribution). Non-null == "is a goal".
  lifetimeTargetAmount Decimal? @db.Decimal(12, 2)

  // A goal's "amount saved so far" (see lib/goals.ts's summarizeGoalProgress)
  // has always been a live sum of this category's own SAVINGS
  // CycleTransactions -- there's no stored total, and this field is a
  // second, independent term ADDED to that sum, never a replacement for
  // it. Money already saved before the goal existed in this app ("already
  // saved $450" at creation) or a correction to the tracked total that
  // shouldn't read as new activity (editing an existing goal's saved
  // amount and choosing not to log it as a transaction) both land here
  // instead of a phantom transaction. Defaults to 0 so every goal that
  // existed before this field was added is unaffected -- its saved total
  // stays exactly the transaction sum it always was.
  manualAdjustment Decimal @default(0) @db.Decimal(12, 2)

  // Only meaningful when recurring == true. BIWEEKLY carries the target into
  // every new cycle (once per quincena, by definition). MONTHLY carries it
  // into exactly one quincena per month, chosen by dueDay: on/before the
  // 15th -> the first quincena of the month, after the 15th -> the second.
  // Defaults to BIWEEKLY so every category that existed before this field
  // was added keeps its old "carries into every cycle" behavior unchanged.
  frequency RecurringFrequency @default(BIWEEKLY)
  dueDay    Int?

  budgetGoals       CycleBudgetGoal[]
  transactions      CycleTransaction[]
  recurringExpenses RecurringExpense[]
  // Also enforced case-insensitively by an expression unique index NOT
  // representable here: UNIQUE(userId, LOWER(name), type). getOrCreateCategory
  // treats "Rent" and "rent" as the same category; this constraint above
  // alone can't catch that collision. See
  // prisma/migrations/20260815035814_race_condition_partial_unique_indexes.

  // Was (userId, name) alone — a Budget (EXPENSE) category and a Goal
  // (SAVINGS) category with the same name used to collide silently (the
  // second upsert would just match/mutate the first, wrong-typed row).
  // type is now part of the identity, so "Travel" the expense and "Travel"
  // the goal are distinct rows.
  @@unique([userId, name, type])
}

enum TransactionType {
  EXPENSE
  INCOME
  SAVINGS
}

// How the transaction arrived — never a substitute for its category (what
// it was for) or its payment method (how it was paid). Manual is anything
// hand-entered via the add/edit sheet; Gmail is anything auto-imported.
enum ImportSource {
  MANUAL
  GMAIL
}

// What was actually paid or received with — orthogonal to both category
// and import source. Parsed from the Gmail email for an import
// (best-effort: card purchases default to Credit unless the body says
// "débito"; a Yappy transfer, sent or received, is always Yappy), or
// picked by the user for a manual entry. Null for SAVINGS, which has no
// payment-method concept.
enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  YAPPY
  ACH
}

model CycleTransaction {
  id                 String            @id @default(cuid())
  cycleId            String
  cycle              BudgetCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  // Denormalized off cycle.userId -- exists purely so sourceMessageId's
  // dedup constraint below can be scoped per-user instead of global (see
  // that field's own comment). Not a Prisma relation; every write path
  // already has the owning userId in hand from the cycle it's creating
  // this row under.
  userId             String
  type               TransactionType
  name               String
  amount             Decimal           @db.Decimal(12, 2)
  expenseCategoryId  String?
  expenseCategory    ExpenseCategory?  @relation(fields: [expenseCategoryId], references: [id], onDelete: SetNull)
  // Set once a payment is either recorded directly against a specific
  // recurring expense (via "Record payment") or a suggested match is
  // confirmed (see lib/recurring-expense-matching.ts) -- null means "not
  // linked to any recurring expense," which is the default for every
  // ordinary manual/Gmail transaction and stays that way unless the user
  // acts on a match suggestion.
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  importSource       ImportSource      @default(MANUAL)
  paymentMethod      PaymentMethod?
  // What the money was for, beyond the name/merchant -- mainly for a Yappy
  // P2P transfer, where "name" is just the counterparty's name and carries
  // no purpose on its own. Populated from Yappy's own "Mensaje" field when
  // the sender filled one in (see lib/gmail-parsers.ts); null when they
  // didn't, which is what prompts the user to fill it in by hand (see the
  // "needs a description" banner alongside the existing category one).
  description        String?
  occurredAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())

  // Set only for transactions auto-imported from Gmail (the message's own
  // id) — the hard dedupe backstop against re-importing the same email
  // twice. Null for every hand-entered transaction; Postgres treats
  // multiple NULLs as distinct under a unique index, so this never
  // collides with manual entries. Scoped per-user (not a bare global
  // @unique) -- a message id colliding across two different users'
  // mailboxes shouldn't silently drop one user's transaction as a
  // "duplicate" of someone else's.
  sourceMessageId String?

  @@unique([userId, sourceMessageId])
  @@index([cycleId])
  @@index([expenseCategoryId])
  @@index([recurringExpenseId])
}

// A category-level aggregate -- always the sum of that category's
// CycleRecurringExpense.targetAmount rows for the same cycle, maintained
// by the recurring-expense server actions on every add/edit/delete/carry-
// forward (see app/(app)/budget/recurring-actions.ts). Kept as its own
// table (rather than replaced by RecurringExpense) so every existing
// category-level reader -- the dashboard budget card, History,
// lib/recurring-expenses.ts's summarizeRecurringExpenses, Manage
// Categories' hasBudgetGoal check -- keeps working unchanged.
model CycleBudgetGoal {
  id                String          @id @default(cuid())
  cycleId           String
  cycle             BudgetCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  expenseCategoryId String
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Cascade)
  targetAmount      Decimal         @db.Decimal(12, 2)
  createdAt         DateTime        @default(now())

  @@unique([cycleId, expenseCategoryId])
  @@index([cycleId])
}

// An individual recurring bill/subscription definition living inside an
// EXPENSE category (e.g. category "Subscriptions" contains RecurringExpense
// rows "Spotify," "Netflix," "iCloud"). Never used for SAVINGS categories --
// the Goals tab keeps using ExpenseCategory.recurring/frequency/dueDay
// directly, untouched by this model.
model RecurringExpense {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  amount     Decimal         @db.Decimal(12, 2)

  // Whether closeCycleAndStartNext auto-carries this recurring expense
  // into the next cycle -- same semantics as ExpenseCategory.recurring
  // today, just scoped per recurring expense instead of per category.
  recurring Boolean            @default(true)
  frequency RecurringFrequency @default(BIWEEKLY)
  // Only meaningful when frequency is MONTHLY (see shouldCarryForwardToCycle
  // in lib/cycles.ts, which is the only current reader). Intentionally NOT
  // used for anything display-side yet -- no due-soon indicator, no
  // sorting by due date, no reminder. Captured because the carry-forward
  // logic needs it now; building on top of it is a deliberate later step,
  // not a gap to "fix."
  dueDay    Int?
  createdAt DateTime           @default(now())

  cycleSnapshots CycleRecurringExpense[]
  transactions   CycleTransaction[]

  @@index([categoryId])
  @@index([userId])
}

// A per-cycle snapshot of a RecurringExpense's target amount -- mirrors
// how CycleBudgetGoal already snapshots a category's target per cycle, so
// a later price change to a RecurringExpense doesn't retroactively rewrite
// past, already-closed cycles.
model CycleRecurringExpense {
  id                 String           @id @default(cuid())
  cycleId            String
  cycle              BudgetCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  recurringExpenseId String
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Cascade)
  targetAmount       Decimal          @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())

  @@unique([cycleId, recurringExpenseId])
  @@index([cycleId])
}
